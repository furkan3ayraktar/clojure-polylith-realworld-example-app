{:mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://clojars.org/repo"}}
 
 :paths     ["resources"]

 :deps      {poly/article-ui {:local/root "../../components/article-ui"}
             poly/auth-ui {:local/root "../../components/auth-ui"}
             poly/core-ui {:local/root "../../components/core-ui"}
             poly/home-ui {:local/root "../../components/home-ui"}
             poly/shared-ui {:local/root "../../components/shared-ui"}
             poly/spec {:local/root "../../components/spec"}
             poly/user-spec {:local/root "../../components/user-spec"}
             poly/web-app {:local/root "../../bases/web-app"}
             poly/web-ui {:local/root "../../components/web-ui"}

             org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases   {:dev {:extra-deps {reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.3.0"}
                                thheller/shadow-cljs {:mvn/version "2.28.15"}
                                binaryage/devtools {:mvn/version "1.0.7"}}}

             :test {; FIXME: This is not allowed. How to run project tests? Do we need a test 
                    ;        runner by Polylith?
                    :extra-paths ["../../components/user-spec/test"
                                  "../../components/web-ui/test"
                                  
                                  "../../bases/web-app/test"]
                    :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}}}}}
