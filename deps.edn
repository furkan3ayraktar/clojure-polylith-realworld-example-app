{:mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://clojars.org/repo"}}

 :aliases   {:dev  {:extra-paths ["development/src"]

                    :extra-deps  {; Components
                                  poly/article {:local/root "components/article"}
                                  poly/article-ui {:local/root "components/article-ui"}
                                  poly/auth-ui {:local/root "components/auth-ui"}
                                  poly/comment {:local/root "components/comment"}
                                  poly/core-ui {:local/root "components/core-ui"}
                                  poly/database {:local/root "components/database"}
                                  poly/env {:local/root "components/env"}
                                  poly/home-ui {:local/root "components/home-ui"}
                                  poly/log {:local/root "components/log"}
                                  poly/profile {:local/root "components/profile"}
                                  poly/shared-ui {:local/root "components/shared-ui"}
                                  poly/shared {:local/root "components/shared"}
                                  poly/spec {:local/root "components/spec"}
                                  poly/tag {:local/root "components/tag"}
                                  poly/user {:local/root "components/user"}
                                  
                                  poly/web-ui {:local/root "components/web-ui"}

                                  ; Bases
                                  poly/rest-api {:local/root "bases/rest-api"}
                                  poly/web-app {:local/root "bases/web-app"}

                                  ; Development dependencies
                                  org.clojure/clojure {:mvn/version "1.12.1"}
                                  org.slf4j/slf4j-nop {:mvn/version "2.0.17"}
                                  io.github.clojure/tools.build {:mvn/version "0.10.10"}
                                  org.clojure/tools.namespace {:mvn/version "1.5.0"}
                                  org.clojure/data.json {:mvn/version "2.5.1"}
                                  clj-http/clj-http {:mvn/version "3.13.1"}
                                  djblue/portal {:mvn/version "0.60.2"}
                                  reagent/reagent {:mvn/version "1.3.0"}
                                  re-frame/re-frame {:mvn/version "1.4.3"}
                                  thheller/shadow-cljs {:mvn/version "3.2.0"}
                                  binaryage/devtools {:mvn/version "1.0.7"}}}

             :test {:extra-paths ["components/article/test"
                                  "components/comment/test"
                                  "components/profile/test"
                                  "components/tag/test"
                                  "components/user/test"
                                  
                                  "components/web-ui/test"

                                  "bases/rest-api/test"
                                  "bases/web-app/test"]
                    :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}}}

             :poly {:main-opts  ["-m" "polylith.clj.core.poly-cli.core"]
                    :extra-deps {polylith/clj-poly
                                 {:git/url "https://github.com/polyfy/polylith.git"
                                  :git/sha "da0e5df90466d32554866b81b34ab4c9fc367795"
                                  :deps/root "projects/poly"}}}

             :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}
                            io.github.seancorfield/build-clj {:git/tag "v0.9.2"
                                                              :git/sha "9c9f078"}
                            org.clojure/tools.deps {:mvn/version "0.16.1281"}
                            org.clojure/tools.cli {:mvn/version "1.0.214"}
                            org.clojure/clojure {:mvn/version "1.12.1"}}
                     :paths []
                     :ns-default build}}}
