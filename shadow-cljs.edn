{:deps {:aliases [:dev :test]}

 :fs-watch {:hawk false}

 :nrepl {:write-port-file true}

 :builds {:app {:target :browser
                :output-dir "bases/web-app/resources/web_app/public/js"
                :asset-path "/js"

                :modules {:main {:init-fn clojure.realworld.web-app.main/init}}

                :compiler-options {:shadow-keywords true}

                :devtools {:http-root "bases/web-app/resources/web_app/public"
                           :http-port 3000}}}}
